# Vendored fb-idb python client (MIT licensed, see LICENSE).
#
# Source: https://github.com/facebook/idb at the release recorded in
# //docs:BUILDING_IDB.md, with patches/idb-build-fixes.patch applied. The
# gRPC files (idb/grpc/idb_pb2.py, idb/grpc/idb_grpc.py) are generated from
# proto/idb.proto by the package's own build (`pip install .`).

load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")

py_library(
    name = "idb_client_lib",
    visibility = ["//visibility:public"],
    srcs = glob(["idb/**/*.py"]),
    imports = ["."],
    deps = [
        "@rules_idb_pip//aiofiles",
        "@rules_idb_pip//grpclib",
        "@rules_idb_pip//protobuf",
    ],
)

py_binary(
    name = "idb_client",
    srcs = ["idb_cli.py"],
    main = "idb_cli.py",
    # Pin the interpreter regardless of the consumer's default python
    # version: the vendored client needs >= 3.10 and the locked pip wheels
    # are resolved for 3.12.
    python_version = "3.12",
    visibility = ["//visibility:public"],
    deps = [":idb_client_lib"],
)
