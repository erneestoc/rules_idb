diff --git a/FBXCTestCore/TestManager/TestBundleConnectionTimeouts.swift b/FBXCTestCore/TestManager/TestBundleConnectionTimeouts.swift
new file mode 100644
index 0000000..9ecb854
--- /dev/null
+++ b/FBXCTestCore/TestManager/TestBundleConnectionTimeouts.swift
@@ -0,0 +1,46 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+import Foundation
+
+/// How long each step of connecting to a test bundle may take before it fails.
+///
+/// These bound how long a failed startup takes to be reported: a host that dies before its bundle
+/// connects is only noticed once the step it was in times out. A caller that has its own deadline
+/// can shorten them with the environment variables named here, in the same way that
+/// `FBXCTEST_CRASH_WAIT_TIMEOUT` bounds the crash log wait in `TestBundleConnection`.
+enum TestBundleConnectionTimeouts {
+
+  static let bundleReadyVariable = "FBXCTEST_BUNDLE_READY_TIMEOUT"
+  static let ideInterfaceReadyVariable = "FBXCTEST_IDE_INTERFACE_TIMEOUT"
+  static let daemonSessionReadyVariable = "FBXCTEST_DAEMON_SESSION_TIMEOUT"
+  static let defaultTimeout: TimeInterval = 60
+
+  /// Time for `_XCT_testBundleReadyWithProtocolVersion` to be called after the 'connect'.
+  static var bundleReady: TimeInterval {
+    timeout(bundleReadyVariable)
+  }
+
+  /// Time for `XCTestManager_IDEInterface` to be returned.
+  static var ideInterfaceReady: TimeInterval {
+    timeout(ideInterfaceReadyVariable)
+  }
+
+  /// Time for testmanagerd to start the test session.
+  static var daemonSessionReady: TimeInterval {
+    timeout(daemonSessionReadyVariable)
+  }
+
+  /// The timeout `variable` names in `environment`, or the default when it is unset or is not a
+  /// positive number of seconds.
+  static func timeout(_ variable: String, environment: [String: String] = ProcessInfo.processInfo.environment) -> TimeInterval {
+    guard let value = environment[variable].flatMap(TimeInterval.init), value > 0, value.isFinite else {
+      return defaultTimeout
+    }
+    return value
+  }
+}
