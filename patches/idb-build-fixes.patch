+  /// environment's `DYLD_INSERT_LIBRARIES` carries the shim that starts XCTest, and its
+  /// `DYLD_FALLBACK_*` paths are where XCTest is found. A request inserting a sanitizer runtime, or
+  /// adding a search path, needs both its own value and the runner's to take effect.
+  static func mergedEnvironment(launchEnvironment: [String: String], requestEnvironment: [String: String]) -> [String: String] {
+    var mEnvironment = launchEnvironment
+    for (key, value) in requestEnvironment {
+      if key.hasPrefix("DYLD_"), let existing = mEnvironment[key], !existing.isEmpty, !value.isEmpty {
+        mEnvironment[key] = "\(existing):\(value)"
+      } else {
+        mEnvironment[key] = value
+      }
     }
     return mEnvironment
   }
