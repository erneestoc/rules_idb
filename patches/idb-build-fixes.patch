diff --git a/CompanionLibTests/Tests/Unit/XCTest/IDBXCTestReporterTests.swift b/CompanionLibTests/Tests/Unit/XCTest/IDBXCTestReporterTests.swift
new file mode 100644
index 0000000..a1e9d7b
--- /dev/null
+++ b/CompanionLibTests/Tests/Unit/XCTest/IDBXCTestReporterTests.swift
@@ -0,0 +1,58 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+@testable import CompanionLib
+import FBControlCore
+import Foundation
+import GRPCCore
+import IDBGRPCSwift
+import Testing
+
+private struct WriterClosed: Error {}
+
+/// A response stream whose client has gone away: every write fails.
+private final class ClosedWriter<Element: Sendable>: RPCWriterProtocol, @unchecked Sendable {
+  func write(_ element: Element) async throws {
+    throw WriterClosed()
+  }
+
+  func write(contentsOf elements: some Sequence<Element>) async throws {
+    throw WriterClosed()
+  }
+}
+
+private final class SilentLogger: ControlCoreLogger, @unchecked Sendable {
+  @discardableResult
+  func log(_ message: String) -> any ControlCoreLogger { self }
+  func info() -> any ControlCoreLogger { self }
+  func debug() -> any ControlCoreLogger { self }
+  func error() -> any ControlCoreLogger { self }
+  func withName(_ name: String) -> any ControlCoreLogger { self }
+  func withDateFormatEnabled(_ enabled: Bool) -> any ControlCoreLogger { self }
+  var name: String? { nil }
+  var level: ControlCoreLogLevel { .multiple }
+}
+
+@Suite
+struct IDBXCTestReporterTests {
+
+  /// The last response takes the stream out of the reporter before it is written, so nothing can
+  /// write after it. If that write fails, waiting for reporting to end has to fail with it rather
+  /// than wait for a response that can no longer arrive.
+  @Test(.timeLimit(.minutes(1)))
+  func aFailedLastResponseEndsReportingWithTheFailure() async {
+    let reporter = IDBXCTestReporter(
+      responseStream: RPCWriter(wrapping: ClosedWriter<Idb_XctestRunResponse>()),
+      logger: SilentLogger())
+
+    reporter.didFinishExecutingTestPlan()
+
+    await #expect(throws: WriterClosed.self) {
+      _ = try await reporter.awaitReportingTerminated()
+    }
+  }
+}
